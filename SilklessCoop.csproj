<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>SilklessCoop</AssemblyName>
        <Product>SilklessCoop</Product>
        <Version>2.2.2</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <RootNamespace>SilklessCoop</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exclude problematic decompiled files -->
        <Compile Remove="SilksongMultiplayer\1Class1.cs" />
        <Compile Remove="SilksongMultiplayer\2Class1.cs" />
        <Compile Remove="SilksongMultiplayer\Class1.cs" />
        <Compile Remove="SilksongMultiplayer\AttackAnimTimeCounter.cs" />
        <Compile Remove="SilksongMultiplayer\CreateLobbyButton.cs" />
        <Compile Remove="SilksongMultiplayer\InviteLobbyButton.cs" />
        <Compile Remove="SilksongMultiplayer\HeroAnimatorHook.cs" />
        <Compile Remove="SilksongMultiplayer\Dummy.cs" />
        <Compile Remove="SilksongMultiplayer\ToolCrestType.cs" />
        <Compile Remove="SilksongMultiplayer\PlayerAvatar.cs" />
        <Compile Remove="SilksongMultiplayer\NetworkDataReceiver.cs" />
        <Compile Remove="SilksongMultiplayer\PlayerNetworkSync.cs" />
        <Compile Remove="SilksongMultiplayer\DDOLFinder.cs" />
        <Compile Remove="SilksongMultiplayer\SilksongMultiplayerAPI.cs" />
        <Compile Remove="SilksongMultiplayer\NetworkDataSender.cs" />
        <Compile Remove="SilksongMultiplayer\OptimizedNetworkDataSender.cs" />
        <Compile Remove="SilksongMultiplayer\OptimizedPlayerAvatar.cs" />
        <Compile Remove="SilksongMultiplayer\OptimizedPlayerNetworkSync.cs" />
        <Compile Remove="SilksongMultiplayer\RoomManager.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
    </ItemGroup>

	<ItemGroup>
		<Reference Include="TeamCherry.TK2D">
			<HintPath>GameLibs/TeamCherry.TK2D.dll</HintPath>
		</Reference>

		<Reference Include="TeamCherry.Localization">
			<HintPath>GameLibs/TeamCherry.Localization.dll</HintPath>
		</Reference>

		<Reference Include="Assembly-CSharp">
			<HintPath>GameLibs/Assembly-CSharp.dll</HintPath>
		</Reference>
		
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>GameLibs/UnityEngine.CoreModule.dll</HintPath>
		</Reference>

		<Reference Include="UnityEngine.UI">
			<HintPath>GameLibs/UnityEngine.UI.dll</HintPath>
		</Reference>

		<Reference Include="com.rlabrecque.steamworks.net">
			<HintPath>GameLibs/com.rlabrecque.steamworks.net.dll</HintPath>
		</Reference>

        <Reference Include="TeamCherry.SharedUtils">
            <HintPath>GameLibs/TeamCherry.SharedUtils.dll</HintPath>
        </Reference>
	</ItemGroup>
  
    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>
</Project>
